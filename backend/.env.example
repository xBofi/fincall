# Copia a .env. Solo infraestructura y secretos: la configuración de negocio vive en PostgreSQL.
BC_REPOSITORIO=memoria            # memoria | postgres
BC_DATABASE_URL=postgresql+asyncpg://building_call:CAMBIAME@localhost:5432/building_call
BC_OLLAMA_URL=http://localhost:11434
BC_OLLAMA_MODELO=qwen3.5:4b
BC_OLLAMA_TIMEOUT_S=120
# STT AssemblyAI (opcional). Endpoint europeo obligatorio.
# BC_ASSEMBLYAI_API_KEY=<clave de AssemblyAI; nunca la copies aquí>
# BC_ASSEMBLYAI_API_BASE=https://api.eu.assemblyai.com
# Fin de turno de AssemblyAI: más silencio = menos cortes al vecino, más latencia (medido: 160 ms ≈ 500 ms fin voz->texto pero corta; 560 ms ≈ 1000 ms)
# BC_ASSEMBLYAI_EOT_CONFIANZA=0.8
# BC_ASSEMBLYAI_EOT_SILENCIO_MS=220   # 160 cortaba a Andreu; 300 no; 220 es el punto medio probado
# BC_ASSEMBLYAI_MAX_SILENCIO_MS=2400
# Consola operativa: usuarios internos con contraseña. Si no hay usuarios al arrancar se crea este
# owner con cambio de contraseña obligatorio en el primer acceso. Gestión en la pestaña Usuarios.
# BC_ADMIN_INICIAL_USUARIO=admin
# BC_ADMIN_INICIAL_CONTRASENA=admin
# BC_LOGIN_MAX_INTENTOS=5          # fallos por usuario o IP antes del bloqueo temporal
# BC_LOGIN_BLOQUEO_S=900
# BC_SESION_SECRETO=cambia-esto-por-un-secreto-largo   # firma las URLs de audio
# BC_SESION_HORAS=12
# Telefonía real (ver docs/TELEFONIA.md). Cuando haya número: rellenar y ejecutar
#   uv run python -m building_call.telefonia.configurar
# BC_TELEFONIA=twilio              # ninguna | twilio
# BC_URL_PUBLICA=https://xxxx.trycloudflare.com   # https pública que llegue a esta API (túnel o dominio)
# BC_TWILIO_ACCOUNT_SID=
# BC_TWILIO_AUTH_TOKEN=
# BC_TWILIO_NUMERO=+34...
# TTS de servidor para telefonía: Piper local (uv sync --extra tts; voz .onnx + .onnx.json en backend/.voces)
# BC_TTS=auto                      # auto | piper | workers_ai | ninguno
# BC_PIPER_MODELO=.voces/es_ES-davefx-medium.onnx
# BC_AUDIO_DIR=.audio             # directorio privado; nunca servido como estático
# BC_AUDIO_RETENCION_DIAS=14
