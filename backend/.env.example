# Copia a .env. Solo infraestructura y secretos: la configuración de negocio vive en PostgreSQL.
# Piloto y producción: todo por API (servidor sin GPU, sin modelos locales). Ollama/Piper/Whisper
# solo para desarrollo en un portátil.
BC_REPOSITORY=memoria            # memoria | postgres
BC_DATABASE_URL=postgresql+asyncpg://building_call:CAMBIAME@localhost:5432/building_call

# Modelo de lenguaje: Gemini en Google Vertex AI, procesado solo en la UE (multi-región "eu").
# Cuenta de servicio con el rol "Vertex AI User"; su JSON en backend/ (ignorado por git).
BC_LLM=vertex                     # vertex | openai | bedrock | workers_ai | ollama | race | auto (auto usa Ollama)
# BC_VERTEX_PROJECT=<id del proyecto de Google Cloud>
# BC_VERTEX_CREDENTIALS=gcp-credenciales.json
# BC_VERTEX_MODEL=gemini-3.5-flash-lite   # medido: 98 % exactitud, p50 626 / p95 722 ms
# OpenAI (BC_LLM=openai): BC_OPENAI_API_KEY, BC_OPENAI_MODEL=gpt-6-luna
#   EU residency (eligible project only): BC_OPENAI_URL=https://eu.api.openai.com
# AWS Bedrock (BC_LLM=bedrock): BC_BEDROCK_API_KEY (Bedrock API key), BC_BEDROCK_REGION=eu-west-1,
#   BC_BEDROCK_MODEL=eu.anthropic.claude-haiku-5-5
# Hybrid routing (uv sync --extra nlp + uv run python nlp/train_classifier.py):
# BC_NLP_HYBRID=false
# BC_NLP_THRESHOLD=0.85
# Desarrollo local sin API: BC_LLM=ollama
# BC_OLLAMA_URL=http://localhost:11434
# BC_OLLAMA_MODEL=qwen3.5:4b

# Voz del bot (teléfono y consola): ElevenLabs en streaming. Sin residencia UE salvo Enterprise.
# Idioma por defecto de las llamadas (es | en; ver backend/src/building_call/i18n/locales). Cada
# llamada puede elegir otro (consola, parámetro del stream, número de Twilio).
# BC_LANGUAGE=es
# BC_LANGUAGES=["es","en","ca","ar","hi","ur"]   # idiomas que atiende este despliegue
# BC_LANGUAGE_DETECTION=true                      # detectar el idioma en los primeros turnos
# BC_LANGUAGE_DETECTION_THRESHOLD=0.6
# BC_PERSONA=demo-residential                     # persona de voz del cliente (i18n/personas)
# BC_TWILIO_NUMBER_LANGUAGES={"+15550100000":"en"}
# BC_TWILIO_NUMBER_PERSONAS={"+15550100000":"demo-residential"}
# BC_PIPER_DIR=.voces                             # una voz Piper por idioma
BC_TTS=elevenlabs                 # elevenlabs | piper | workers_ai | ninguno | auto
# BC_ELEVENLABS_API_KEY=<clave de ElevenLabs; nunca la copies aquí>
# BC_ELEVENLABS_VOICE=<voice ID>
# BC_ELEVENLABS_MODEL=eleven_v4_turbo     # primer audio ~158 ms
# Desarrollo local sin API: BC_TTS=piper (uv sync --extra tts; voz .onnx + .onnx.json en backend/.voces)
# BC_PIPER_MODEL=.voces/es_ES-davefx-medium.onnx

# Transcripción: AssemblyAI en streaming. Endpoint europeo obligatorio (validado en código).
# BC_ASSEMBLYAI_API_KEY=<clave de AssemblyAI; nunca la copies aquí>
# BC_ASSEMBLYAI_API_BASE=https://api.eu.assemblyai.com
# Fin de turno de AssemblyAI: más silencio = menos cortes al vecino, más latencia (medido: 160 ms ≈ 500 ms fin voz->texto pero corta; 560 ms ≈ 1000 ms)
# BC_ASSEMBLYAI_EOT_CONFIDENCE=0.8
# BC_ASSEMBLYAI_EOT_SILENCE_MS=220   # 160 cortaba a Andreu; 300 no; 220 es el punto medio probado
# BC_ASSEMBLYAI_MAX_SILENCE_MS=2400

# Consola operativa: se entra solo con Google o Microsoft. BC_OWNER_EMAIL entra como owner; el
# resto solicita acceso y el owner lo concede en la pestaña Solicitudes. En Google Cloud y en
# Microsoft Entra la URI de redirección es {BC_CONSOLE_URL}/api/auth/oidc/google|microsoft/retorno
# BC_CONSOLE_URL=http://localhost:5173
# BC_OWNER_EMAIL=
# BC_GOOGLE_CLIENT_ID=
# BC_GOOGLE_CLIENT_SECRET=<nunca la copies aquí>
# BC_MICROSOFT_CLIENT_ID=
# BC_MICROSOFT_CLIENT_SECRET=<nunca la copies aquí>
# OBLIGATORIO con BC_REPOSITORY=postgres (mínimo 32 caracteres): firma las URLs con las que
# se descargan las grabaciones. Sin él la API no arranca en modo real. Genéralo con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# BC_SESSION_SECRET=
# LiveKit: el agente de voz entra en la API con este secreto (mínimo 32 caracteres; más corto se
# rechaza). Genéralo con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# BC_AGENT_SECRET=
# BC_SESSION_DAYS=30               # se alarga sola al usar la consola
# Telefonía real (ver docs/TELEFONIA.md). Cuando haya número: rellenar y ejecutar
#   uv run python -m building_call.telephony.configure
# BC_TELEPHONY=twilio              # ninguna | twilio
# BC_PUBLIC_URL=https://xxxx.trycloudflare.com   # https pública que llegue a esta API (túnel o dominio)
# BC_TWILIO_ACCOUNT_SID=
# BC_TWILIO_AUTH_TOKEN=
# BC_TWILIO_NUMBER=+34...
# Llamadas desde la consola por Twilio (Voice JS SDK, sin número): API key + TwiML App.
# `uv run python -m building_call.telephony.configure --twiml-app` crea la TwiML App.
# BC_TWILIO_API_KEY_SID=SK...
# BC_TWILIO_API_KEY_SECRET=<nunca aquí: SecretBroker>
# BC_TWILIO_TWIML_APP_SID=AP...
# BC_AUDIO_DIR=.audio             # directorio privado; nunca servido como estático
# BC_AUDIO_RETENTION_DAYS=14
