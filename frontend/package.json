{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "preinstall": "node scripts/enforce-pnpm.mjs",
    "dev": "node scripts/enforce-pnpm.mjs && vite",
    "build": "node scripts/enforce-pnpm.mjs && tsc -b && vite build",
    "lint": "node scripts/enforce-pnpm.mjs && oxlint",
