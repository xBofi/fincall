      "parameters": {
        "jsCode": "// Proposes the next working day, 9:00–11:00 (Europe/Madrid), and the sentence the assistant will\n// say. Fincall validates slot_text before speaking it (short, plain text).\nconst req = $input.first().json;\nconst days = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'];\nconst d = new Date();\ndo { d.setDate(d.getDate() + 1); } while (d.getDay() === 0 || d.getDay() === 6);\nconst ymd = d.toISOString().slice(0, 10);\nreturn [{ json: {\n  ...req,\n  start: `${ymd}T09:00:00`,\n  end: `${ymd}T11:00:00`,\n  slot_text: `el ${days[d.getDay()]} ${d.getDate()} entre las 9:00 y las 11:00`,\n  demo: $env.FINCALL_CALENDAR_DEMO === 'true',\n} }];"
      },
